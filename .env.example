# Copy to .env and fill in. .env is gitignored.
#
# Defaults below target api.openai.com. Engram speaks one protocol — the
# OpenAI-compatible /v1/embeddings and /v1/chat/completions endpoints — so any
# gateway that implements it works, including for Gemini and Claude models.
# See the worked example at the bottom: one key and one base URL normally
# serve both embeddings and chat.

# ── Required ────────────────────────────────────────────────

# Bearer token for the MCP HTTP endpoint. The container will not start
# without it. Generate with: openssl rand -hex 32
ENGRAM_AUTH_TOKEN=

# Embeddings are required, not optional. Without them Engram degrades to
# keyword-only search — it will still run, but semantic recall is the whole
# point of the system.
OPENAI_API_KEY=

# There is no built-in default model; an unset model is a startup error.
ENGRAM_LLM_MODEL=gpt-4o-mini
ENGRAM_LLM_API_KEY=

# ── Embeddings ──────────────────────────────────────────────

# The API ROOT, not the versioned path. Engram appends /v1/embeddings itself,
# so "https://host/v1" produces /v1/v1/embeddings and 404s. Note this differs
# from most other tools, which want the /v1 form.
#
# CAUTION: docker compose gives your SHELL environment precedence over this
# file. If you already export OPENAI_BASE_URL for other tools — very likely,
# and very likely with a /v1 suffix — it silently overrides what you set here.
# Check with:  docker compose config | grep OPENAI_BASE_URL
# OPENAI_BASE_URL=https://api.openai.com

# text-embedding-3-small (1536 dims) is the default and a good choice.
# text-embedding-3-large (3072) costs more for a modest gain.
#
# Worth choosing deliberately rather than inheriting: in the Mnemis ablation
# (ACL 2026, Table 6) the embedding model alone moved LoCoMo accuracy by 18.2
# points — more than any retrieval architecture change they measured.
# ENGRAM_EMBEDDING_MODEL=text-embedding-3-small

# Leave unset unless your model is non-standard. Setting it makes Engram send
# a `dimensions` parameter that some OpenAI-compatible gateways reject.
#
# WARNING: the dimension is baked into the vault on first write. Changing the
# model or this value afterwards is rejected at startup and there is no
# migration path. Decide before the vault has content:
# docs/references/embedding-config-is-immutable.md
# ENGRAM_EMBEDDING_DIMS=

# ── LLM ─────────────────────────────────────────────────────

# The OpenAI-compatible /v1/chat/completions route is the only transport.
# Native Gemini and Anthropic clients were removed — point ENGRAM_LLM_BASE_URL
# at a gateway (LiteLLM, vLLM, OpenRouter, Vertex's compatibility layer) to
# reach Gemini or Claude models through it.
#
# Root URL for the chat route. Leave unset for api.openai.com.
# ENGRAM_LLM_BASE_URL=

# ── Optional ────────────────────────────────────────────────

# Comma-separated EXACT origins allowed to call the API from a browser.
# Empty (the default) sends no CORS header at all. No prefix matching.
# ENGRAM_CORS_ORIGIN=https://app.example.com

# Host port to publish. Bound to 127.0.0.1 by the compose file.
# ENGRAM_HOST_PORT=3801

# ── Worked example: behind a LiteLLM gateway ────────────────
#
# Verified working against api.ackstorm.ai. One key, one base URL, one route:
# the OpenAI-compatible endpoint serves both the embedding model and the
# proxied Gemini chat model.
#
#   ENGRAM_AUTH_TOKEN=<openssl rand -hex 32>
#
#   OPENAI_API_KEY=<litellm key>
#   OPENAI_BASE_URL=https://api.ackstorm.ai
#   ENGRAM_EMBEDDING_MODEL=openai.text-embedding-3-large
#   ENGRAM_EMBEDDING_DIMS=512
#
# That pairing measured best on eval/retrieval.ts — 72% recall@1 and MRR 0.853
# against 68% and 0.810 for 3-small — while using a third of the storage. This
# gateway supports OpenAI's `dimensions` parameter; the shipped defaults stay on
# 3-small at native width because not every gateway does.
#
#   ENGRAM_LLM_API_KEY=<same litellm key>
#   ENGRAM_LLM_BASE_URL=https://api.ackstorm.ai
#   ENGRAM_LLM_MODEL=ackstorm.fast          # alias for gemini-flash-latest
#
# Two gotchas that cost real debugging time:
#
#   - Gateway model names are namespaced. The embedding model is
#     `openai.text-embedding-3-small`, not `text-embedding-3-small`.
#   - Gateway aliases such as `ackstorm.fast` resolve against the gateway's
#     catalogue, not the upstream provider's.
#
# A team key may be authorised for chat models but not embedding ones. Check
# both before assuming the base URL is wrong.
