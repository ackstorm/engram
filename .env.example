# Copy to .env and fill in. .env is gitignored.

# Bearer token for the MCP HTTP endpoint. Required — the container will not
# start without it. Generate with: openssl rand -hex 32
ENGRAM_AUTH_TOKEN=

# Google Gemini API key, used for both embeddings and LLM consolidation.
GEMINI_API_KEY=

# Optional: point Gemini traffic at a proxy or gateway instead of Google.
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: comma-separated exact origins allowed to call the API from a
# browser. Empty (the default) disables CORS entirely.
# ENGRAM_CORS_ORIGIN=https://app.example.com

# Optional: host port to publish. Bound to 127.0.0.1 by the compose file.
# ENGRAM_HOST_PORT=3801
